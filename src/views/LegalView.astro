---
import { type CollectionEntry, render } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { formatDate } from "@lib/utils"
import { SITE } from "@consts"
import { entryLang, useTranslations } from "@i18n/index"

type Props = { entry: CollectionEntry<"legal"> }

const { entry } = Astro.props
const lang = entryLang(entry)
const t = useTranslations(lang)
const { title, date } = entry.data
const { Content } = await render(entry)
---

<PageLayout title={title} description={`${title} ${t("legal.for")} ${SITE.TITLE}`}>
  <TopLayout>
    <div class="animate">
      <h1 class="page-heading">
        {title}
      </h1>
      <p class="font-normal opacity-75">
        {t("legal.updated")} {formatDate(date, lang)}
      </p>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate">
      <Content/>
    </article>
  </BottomLayout>
</PageLayout>
