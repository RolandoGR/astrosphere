---
import { render } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { getLocalized, useTranslations, type Lang } from "@i18n/index"

type Props = { lang: Lang }

const { lang } = Astro.props
const t = useTranslations(lang)

const work = await Promise.all(
  (await getLocalized("work", lang)).map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

function formatWorkDate(input: Date | string) {
  if (typeof input === "string") return lang === "es" && input === "Present" ? "Presente" : input

  const month = input.toLocaleDateString(lang === "es" ? "es-MX" : "en-US", {
    month: "short",
  })

  const year = new Date(input).getFullYear()
  return `${month} ${year}`
}
---

<PageLayout title={t("work.title")} description={t("work.description")}>
  <TopLayout>
    <h1 class="animate page-heading">
      {t("work.title")}
    </h1>
  </TopLayout>
  <BottomLayout>
    <ul>
      {
        work.map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4">
              {formatWorkDate(entry.data.dateStart)} - {formatWorkDate(entry.data.dateEnd)}
            </div>
            <div class="font-display text-lg text-black dark:text-white font-semibold">
              {entry.data.company}
            </div>
            <div class="text-sm font-semibold text-teal-700 dark:text-teal-300">
              {entry.data.role}
            </div>
            <article class="prose dark:prose-invert">
              <entry.Content />
            </article>
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>
