---
import PageLayout from "@layouts/PageLayout.astro"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"
---

<PageLayout title="Page not found" description="This page drifted out of orbit.">

  <!-- Dark Theme: Twinkling Stars / Meteors -->
  <div id="galaxy" class="fixed inset-0">
    <div class="hidden dark:block">
      <TwinklingStars/>
      <MeteorShower/>
    </div>
  </div>

  <section class="relative min-h-screen w-full flex items-center justify-center p-5 text-center">
    <div class="animate">
      <p class="text-7xl md:text-9xl font-bold text-black dark:text-white">
        404
      </p>
      <p class="mt-4 text-lg md:text-xl font-semibold text-black dark:text-white">
        Lost in space
      </p>
      <p class="mt-2 opacity-75">
        This page drifted out of orbit, or it never existed.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-8">
        <a href="/" class="py-2 px-4 rounded text-sm md:text-base bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend">
          Back to home
        </a>
        <a href="/search" class="py-2 px-4 rounded text-sm md:text-base border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
          Search the site
        </a>
      </div>
    </div>
  </section>
</PageLayout>
