---
import { langFromUrl, localizePath, useTranslations } from "@i18n/index"

const lang = langFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section id="hero" class="relative h-svh min-h-[560px] w-full overflow-hidden bg-[#f3f0ff] dark:bg-[#05040f]">
  <canvas class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <div class="relative mx-auto flex h-full max-w-screen-lg items-end px-5 pb-[12vh] md:items-center md:pb-0">
    <div class="pointer-events-none max-w-xl font-display">
      <p class="animate text-sm uppercase tracking-[0.28em] text-violet-700 dark:text-indigo-300 md:text-base">
        {t("home.hello")}
      </p>
      <h1 class="animate mt-3 text-5xl font-bold leading-[0.95] tracking-tight text-black dark:text-white md:text-7xl">
        Rolando<br/>
        <span class="bg-gradient-to-r from-violet-600 to-cyan-600 bg-clip-text text-transparent dark:from-violet-300 dark:to-cyan-300">
          García Ramos
        </span>
      </h1>
      <p class="animate mt-4 text-base text-black/70 dark:text-white/75 md:text-lg">
        {t("home.tagline")}
      </p>
      <div class="animate pointer-events-auto mt-6 flex flex-wrap gap-3">
        <a href={localizePath("/work", lang)} class="rounded-md bg-gradient-to-r from-violet-600 to-cyan-600 px-4 py-2 text-sm text-white hover:opacity-90 md:text-base blend">
          {t("home.cta.work")}
        </a>
        <a href={localizePath("/blog", lang)} class="rounded-md border border-black/20 px-4 py-2 text-sm text-black hover:bg-black/5 dark:border-white/25 dark:text-white dark:hover:bg-white/10 md:text-base blend">
          {t("home.cta.blog")}
        </a>
      </div>
    </div>
  </div>
  <p class="pointer-events-none absolute bottom-4 right-5 hidden text-xs text-black/40 dark:text-white/40 md:block">
    {t("home.hint")}
  </p>
</section>

<script>
  import { createGalaxy } from "@lib/galaxy"

  const hero = document.getElementById("hero")!
  const canvas = hero.querySelector("canvas")!
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const wide = (w: number) => w >= 768

  const galaxy = createGalaxy(canvas, {
    count: hero.clientWidth < 640 ? 2400 : 4200,
    center: (w, h) => wide(w) ? [w * 0.66, h * 0.48] : [w * 0.5, h * 0.3],
    radius: (w, h) => wide(w) ? Math.min(w * 0.3, h * 0.55) : Math.min(w * 0.55, h * 0.4),
  })

  const isDark = () => document.documentElement.classList.contains("dark")
  galaxy.setTheme(isDark())

  let raf = 0
  let visible = true
  const frame = (t: number) => {
    galaxy.draw(t)
    raf = requestAnimationFrame(frame)
  }
  const start = () => {
    if (reduced) galaxy.draw(performance.now())
    else if (!raf) raf = requestAnimationFrame(frame)
  }
  const stop = () => {
    cancelAnimationFrame(raf)
    raf = 0
  }
  const redrawIfIdle = () => {
    if (reduced || !visible) galaxy.draw(performance.now())
  }

  new ResizeObserver(() => {
    galaxy.resize(hero.clientWidth, hero.clientHeight)
    redrawIfIdle()
  }).observe(hero)

  // Only animate while the hero is on screen
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting
    if (visible) start()
    else stop()
  }).observe(hero)

  new MutationObserver(() => {
    galaxy.setTheme(isDark())
    redrawIfIdle()
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] })

  const local = (e: PointerEvent | MouseEvent) => {
    const rect = hero.getBoundingClientRect()
    return [e.clientX - rect.left, e.clientY - rect.top] as const
  }
  hero.addEventListener("pointermove", (e) => galaxy.pointer(...local(e)))
  hero.addEventListener("pointerleave", () => galaxy.leave())
  hero.addEventListener("click", (e) => {
    if (reduced || (e.target as Element).closest("a, button")) return
    galaxy.supernova(...local(e))
  })
</script>
