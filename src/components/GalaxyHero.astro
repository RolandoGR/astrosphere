---
import { langFromUrl, localizePath, useTranslations } from "@i18n/index"

const lang = langFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section id="hero" class="relative h-svh min-h-[560px] w-full overflow-hidden bg-[#eef8f6] dark:bg-[#03090b]">
  <canvas class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <div class="relative mx-auto flex h-full max-w-screen-lg items-end px-5 pb-[12vh] md:items-center md:pb-0">
    <div class="hero-text pointer-events-none relative isolate max-w-xl font-display">
      <p class="animate text-sm uppercase tracking-[0.28em] text-teal-700 dark:text-teal-300 md:text-base">
        {t("home.hello")}
      </p>
      <h1 class="animate mt-3 text-5xl font-bold leading-[0.95] tracking-tight text-black dark:text-white md:text-7xl">
        Rolando<br/>
        <span class="bg-gradient-to-r from-teal-700 to-cyan-600 bg-clip-text text-transparent dark:from-teal-300 dark:to-cyan-300">
          García Ramos
        </span>
      </h1>
      <p class="animate mt-4 text-base font-medium text-black/85 dark:text-white/90 md:text-lg">
        {t("home.tagline")}
      </p>
      <div class="animate pointer-events-auto mt-6 flex flex-wrap gap-3">
        <a href={localizePath("/work", lang)} class="rounded-md bg-gradient-to-r from-teal-700 to-cyan-700 px-4 py-2 text-sm text-white hover:opacity-90 md:text-base blend">
          {t("home.cta.work")}
        </a>
        <a href={localizePath("/blog", lang)} class="rounded-md border border-black/20 px-4 py-2 text-sm text-black hover:bg-black/5 dark:border-white/25 dark:text-white dark:hover:bg-white/10 md:text-base blend">
          {t("home.cta.blog")}
        </a>
      </div>
    </div>
  </div>
  <p class="pointer-events-none absolute bottom-4 right-5 hidden text-xs text-black/40 dark:text-white/40 md:block">
    {t("home.hint")}
  </p>
</section>

<script>
  import { mountGalaxy } from "@lib/galaxy-mount"
  import { siteGalaxy } from "@lib/galaxy-look"

  const hero = document.getElementById("hero")!
  const wide = (w: number) => w >= 768
  const small = hero.clientWidth < 640

  mountGalaxy(hero, {
    params: small ? { ...siteGalaxy, bgStars: 1200 } : siteGalaxy,
    stars: small ? 12000 : 35000,
    fallbackStars: small ? 2400 : 4200,
    scroll: true,
    center: (w, h) => wide(w) ? [w * 0.7, h * 0.48] : [w * 0.5, h * 0.3],
    radius: (w, h) => wide(w) ? Math.min(w * 0.34, h * 0.6) : Math.min(w * 0.55, h * 0.4),
  })
</script>

<style>
  /* Hero background color as RGB channels, for the veil and the halo */
  #hero { --hero-bg: 238 248 246; }
  :global(.dark) #hero { --hero-bg: 3 9 11; }

  /* A soft veil behind the text dims the stars that cross it */
  .hero-text::before {
    content: "";
    position: absolute;
    inset: -35% -30%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--hero-bg) / 0.85), rgb(var(--hero-bg) / 0.6) 55%, rgb(var(--hero-bg) / 0));
  }

  /* A halo in the background color keeps the letters crisp over bright stars.
     Not on the gradient name: a shadow would show through its clipped text */
  .hero-text > p,
  .hero-text h1 {
    text-shadow: 0 0 10px rgb(var(--hero-bg) / 0.95), 0 0 26px rgb(var(--hero-bg) / 0.85);
  }
  .hero-text h1 span { text-shadow: none; }
</style>
